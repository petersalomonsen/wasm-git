// The interfaces lg2 imports on top of what wasi-libc already uses.
// C bindings are generated from this world by build.sh.
package wasmgit:lg2;

world lg2-http {
  import wasi:http/outgoing-handler@0.2.12;
}

// The git smart HTTP server example (build.sh server).
world git-server {
  export wasi:http/incoming-handler@0.2.12;
}
